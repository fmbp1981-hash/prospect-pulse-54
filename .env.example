# ─── SUPABASE ─────────────────────────────────────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # NUNCA expor no client-side

# ─── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── PROSPECÇÃO — FIRECRAWL e APIFY (fallback; cada tenant pode configurar a
# própria chave em Configurações > Prospecção, que tem prioridade sobre isto) ──
# Firecrawl: enriquecimento de site institucional (nunca usado no canal LinkedIn)
# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY="fc-..."
# Apify: conector LinkedIn (camada cookieless)
# https://console.apify.com/settings/integrations
APIFY_API_KEY="apify_api_..."

# ─── WHATSAPP PROVIDER ────────────────────────────────────────────────────────
# Valores: "evolution" (padrão) | "meta"
WHATSAPP_PROVIDER="evolution"

# Evolution API (provider=evolution)
EVOLUTION_API_URL="https://evolution.seudominio.com"
EVOLUTION_API_KEY="sua-api-key-evolution"

# Meta Cloud API Oficial (provider=meta)
META_WA_TOKEN="EAAxxxxx"                 # System User Token
META_WA_PHONE_NUMBER_ID="123456789"      # ID do número no painel Meta
META_WA_VERSION="v20.0"                  # Versão da Graph API
META_WA_VERIFY_TOKEN="seu-verify-token"  # Token para verificação de webhook
META_APP_SECRET=                         # App Secret da Meta: valida X-Hub-Signature-256 (obrigatório com Meta; sem ele o webhook responde 503)

# ─── EMAIL MARKETING (Resend) ─────────────────────────────────────────────────
# https://resend.com → API Keys → Create API Key
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Domínio verificado no Resend (ex: noreply@seudominio.com.br)
FROM_EMAIL="noreply@seudominio.com.br"

# ─── OPENAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── CRON JOBS (segurança) ────────────────────────────────────────────────────
# Vercel Cron envia: Authorization: Bearer ${CRON_SECRET}
CRON_SECRET="seu-segredo-cron-aqui"

# ─── IMPORTANTE ───────────────────────────────────────────────────────────────
# Nunca faça commit do arquivo .env.local com valores reais!
# Copie este arquivo: cp .env.example .env.local

# Admin da plataforma: não há variável de ambiente. É definido só pela tabela
# public.platform_admins (migration 20261030130000), via service_role/SQL.
