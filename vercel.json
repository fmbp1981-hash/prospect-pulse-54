{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/follow-up",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/long-followup",
      "schedule": "0 12 * * 1-5"
    }
  ]
}
