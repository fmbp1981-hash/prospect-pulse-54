{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospect-pulse-54",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-09-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "prospect-pulse-54"
    }
  ],
  // Vars públicas NEXT_PUBLIC_* — precisam estar aqui (build-time) além do
  // dashboard Cloudflare (Settings > Variables and Secrets > Environment
  // Variables), porque são inlined pelo Next.js/webpack durante o build, não
  // apenas lidas em runtime pelo Worker. Segredos sensíveis (Service Role Key,
  // Firecrawl, Apify etc.) NÃO vão aqui — são enviados via
  // scripts/cloudflare-secrets-sync.sh (wrangler secret put).
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://kzvnwqlcrtxwagxkghxq.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt6dm53cWxjcnR4d2FneGtnaHhxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjE2MjA4OTksImV4cCI6MjA3NzE5Njg5OX0.cOfLX6lW4jHmeHXKZlyKsgggfttK3jftIDzZgCfefgs",
    "NEXT_PUBLIC_APP_URL": "https://prospect-pulse-54.fmbp1981.workers.dev"
  },
  // Cron Triggers — equivalentes aos jobs que rodavam via vercel.json (crons
  // nativos da Vercel) + os 2 que estavam órfãos (rescue-human-mode,
  // keepalive), religados por decisão do usuário (ver
  // CLOUDFLARE_MIGRATION_PLAN.md, Fase 2). O handler scheduled() em
  // custom-worker.ts mapeia cada expressão pra sua rota.
  "triggers": {
    "crons": [
      "* * * * *",       // follow-up — a cada minuto
      "0 12 * * 1-5",     // long-followup — seg-sex 12h UTC (9h BRT)
      "0 * * * *",        // rescue-human-mode — a cada hora
      "0 0 */5 * *"        // keepalive — a cada 5 dias
    ]
  }
}
